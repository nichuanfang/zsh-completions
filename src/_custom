#compdef mcd vclear vcp proxy noproxy

# 这是一个集成的 Zsh 补全入口文件
# 通过上面的 #compdef 可以一次性声明多个命令的补全关联

_my_custom_funcs() {
    # 获取当前正在补全的命令名称 (如 mcd, vcp 等)
    local curcontext="$curcontext"
    
    case "$service" in
        mcd)
            # 补全目录，并加上描述说明
            _arguments '*:directory:_path_files -/'
            ;;
        vclear|vcp)
            # 补全普通文件，并加上描述说明
            _arguments '*:file:_path_files -'
            ;;
        proxy|noproxy)
            # 这两个命令不需要参数，直接返回
            return 0
            ;;
    }
}

# 将该补全函数应用到上述所有命令
_my_custom_funcs "$@"