#compdef duti

# Zsh completion for duti (macOS default application handler tool)

_duti() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments \
    '(-h --help)'{-h,--help}'[print usage and exit]' \
    '(-V --version)'{-V,--version}'[print version number and exit]' \
    '(-v --verbose)'{-v,--verbose}'[verbose output]' \
    '(-s --set)'{-s,--set}'[set the handler from command line arguments]: :_duti_set' \
    '(-d --default)'{-d,--default}'[display the default handler for UTI and exit]:uti' \
    '(-l --list)'{-l,--list}'[display all handlers for UTI and exit]:uti' \
    '(-x --extension)'{-x,--extension}'[print information for extension]:extension' \
    '1: :_files' \
    '*:: :->args'

  case $state in
    args)
      _files
      ;;
  esac
}

_duti_set() {
  _arguments \
    ':bundle_id:' \
    ':uti_or_scheme_or_ext:' \
    ':role:(all viewer editor shell none)'
}