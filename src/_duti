#compdef duti
# ------------------------------------------------------------------------------
# Description
# -----------
#
# Completion script for duti — set default document and URL handlers on macOS.
#
# ------------------------------------------------------------------------------
# Authors
# -------
#
# * Nichuan Fang
#
# ------------------------------------------------------------------------------

_duti() {
  local curcontext="$curcontext" ret=1
  local -a state line
  typeset -A opt_args

  local -a roles
  roles=(
    'all:application handles all roles for the given UTI'
    'viewer:application handles reading and displaying documents'
    'editor:application can manipulate and save the item'
    'shell:application can execute the item'
    'none:application cannot open the item, but provides an icon'
  )

  _arguments -C -s -S \
    '(- *)'{-h,--help}'[show help message and exit]' \
    '(- *)'{-V,--version}'[print version and exit]' \
    '(- *)'{-v,--verbose}'[enable verbose output]' \
    '(-x -s)-d[show default handler for given UTI]:UTI: ' \
    '(-x -s)-l[list all handlers for given UTI]:UTI: ' \
    '(-d -l -s)-x[get default application info for extension]:extension: ' \
    '(-d -l -x)-s[set default handler]: :->bundle-id' \
    '*:: :->args' && ret=0

  case $state in
    (bundle-id)
      _message -e bundle-ids 'bundle ID (e.g. com.apple.Safari)'
      ret=0
      ;;
    (args)
      if [[ -n ${opt_args[-s]:-} ]]; then
        local -i s_pos=${words[(ie)-s]}
        local -a tail=(${words[$((s_pos+1)),-1]})
        case ${#tail} in
          (0|1)
            _message -e handler-targets \
              'UTI, URL scheme, extension (.txt), or MIME type (text/plain)' && ret=0
            ;;
          (2)
            _describe -t roles role roles && ret=0
            ;;
          (*)
            _files && ret=0
            ;;
        esac
      else
        _files && ret=0
      fi
      ;;
  esac

  return ret
}

_duti "$@"

