#compdef duti
# ------------------------------------------------------------------------------
# Description
# -----------
#
#  Completion script for duti (https://github.com/moretension/duti),
#  a macOS command-line tool to manage default application
#  associations for UTIs, URL schemes and file extensions.
#
#  Usage
#  -----
#    duti [ -hvV ] [ -d uti ] [ -l uti ] [ settings_path ]
#    duti -s bundle_id { uti | url_scheme } [ role ]
#    duti -x extension
#
# ------------------------------------------------------------------------------

_duti_roles() {
  local roles

  roles=(
    "all:handle all roles"
    "editor:handle as editor"
    "viewer:handle as viewer"
    "shell:handle as shell/default app"
    "none:no specific role"
  )

  _describe -t roles 'role' roles
}

_duti_bundle_ids() {
  local -a complbundles
  local id app

  complbundles=()
  for app in /Applications/*.app(N) /Applications/*/*.app(N) /System/Applications/*.app(N) ~/Applications/*.app(N); do
    id=$(mdls -name kMDItemCFBundleIdentifier -raw "$app" 2>/dev/null)
    [[ -n "$id" && "$id" != "(null)" ]] && complbundles+=("$id:${app:t:r}")
  done

  _describe -t complbundles 'bundle identifier' complbundles
}

_duti() {
  local curcontext="$curcontext" ret=1
  local -a state line

  _arguments -C -s \
    '(- 1 *)'{-h,--help}'[display usage information]' \
    '(- 1 *)'{-V,--version}'[display version information]' \
    '(-v --verbose)'{-v,--verbose}'[be verbose]' \
    '(-d -l -s -x)-d[delete default application association for a uti]:uti' \
    '(-d -l -s -x)-l[list default application association for a uti]:uti' \
    '(-d -l -s -x)-s[set default application for a uti or url scheme]:bundle id:_duti_bundle_ids' \
    '(-d -l -s -x)-x[get default application bundle id for a file extension]:extension' \
    '1: :->cmds' \
    '*:: :->args' && ret=0

  case "$state" in
    (cmds)
      _files -g '*.duti' && ret=0
      ;;
    (args)
      case "${words[1]}" in
        (-s)
          case $CURRENT in
            (2)
              _duti_bundle_ids && ret=0
              ;;
            (3)
              _message 'UTI (e.g. public.plain-text) or URL scheme (e.g. http)' && ret=0
              ;;
            (4)
              _duti_roles && ret=0
              ;;
          esac
          ;;
        (*)
          _default && ret=0
          ;;
      esac
      ;;
    (*)
      ;;
  esac

  return ret
}

_duti "$@"

