#compdef duti

_duti() {
  local context state state_descr line
  typeset -A opt_args

  # 规范化了选项定义，去掉了多余的反斜杠，并将 `1:` 改为 `*:` 以支持多个文件
  _arguments -s -S \
    '(-h)-h[打印帮助信息并退出]' \
    '(-V)-V[打印版本号并退出]' \
    '(-v)-v[开启详细输出模式]' \
    '(-d)-d[显示指定 UTI 的当前默认 Handler]:UTI:' \
    '(-l)-l[显示指定 UTI 的所有 Handler]:UTI:' \
    '(-x)-x[显示指定文件扩展名的默认 Handler]:扩展名:' \
    '(-s)-s[设置默认 Handler]:bundle_id:->bundle:UTI 或扩展名:->uti:角色:->roles' \
    '*:配置文件或目录:_files'

  # 利用 Zsh 的状态机，依次处理 -s 后面的三个参数
  case $state in
    bundle)
      # 这里可以替换为你获取系统 bundle_id 列表的函数，目前仅做提示
      _message "输入 bundle_id (例如: com.apple.Safari)"
      ;;
    uti)
      _message "输入 UTI 或扩展名 (例如: public.html 或 .txt)"
      ;;
    roles)
      local -a roles=(
        'all:处理该 UTI/扩展名的所有角色'
        'viewer:仅读取和显示文档'
        'editor:编辑并保存文档'
        'shell:可执行该文档'
        'none:无法打开，仅提供图标'
      )
      _describe -t roles '角色 (role)' roles
      ;;
  esac
}

_duti "$@"